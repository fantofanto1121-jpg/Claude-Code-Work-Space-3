# ============================================================
#  環境変数テンプレート
#  このファイルをコピーして .env を作り、値を書き換えてください。
#    cp .env.example .env
#  .env は絶対に GitHub にコミットしないでください（.gitignore 済み）。
# ============================================================

# --- 必須 ---------------------------------------------------
# セッションCookieとCSRFトークンの署名に使う秘密鍵。
# 生成コマンド:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ここに生成したランダム文字列を貼り付ける

# データベース接続URL。
#   ローカル開発（何も用意しなくても動く）: sqlite:///./bbs.db
#   本番 (Neon などの PostgreSQL)        : postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./bbs.db

# --- 動作環境 -----------------------------------------------
# development か production。production では Cookie に Secure 属性が付きます（HTTPS 必須）。
APP_ENV=development

# 公開URL（パスワード再設定メールのリンク生成に使用）
BASE_URL=http://127.0.0.1:8000

# サイト名（画面表示とメール差出人名に使用）
SITE_NAME=カワラ版

# --- 管理者 -------------------------------------------------
# 管理者にするメールアドレス。カンマ区切りで複数可。
# ここに書いたアドレスで登録・ログインしたユーザーだけが管理画面に入れます。
ADMIN_EMAILS=

# --- メール送信（任意・未設定ならリンクをサーバーログに出力）----
# Resend (https://resend.com) の APIキー。空欄なら送信せずログ出力のみ。
RESEND_API_KEY=
MAIL_FROM=noreply@example.com

# メール確認を必須にするか（true / false）。
# true にすると、メール内のリンクを踏むまで投稿できません。
# メール送信を設定していない場合は false のままにしてください。
REQUIRE_EMAIL_VERIFICATION=false

# --- リバースプロキシ ----------------------------------------
# Render などプロキシ配下に置く場合 true。X-Forwarded-For からIPを取得します。
TRUST_PROXY_HEADERS=false
